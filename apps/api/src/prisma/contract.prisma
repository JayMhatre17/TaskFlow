// use prisma-next

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  PENDING_DELETION
  DELETED
}

model User {
  id           Int    @id @default(autoincrement())
  name         String
  email        String @unique
  passwordHash String

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  // Protected emergency Admin
  isProtectedAdmin Boolean @default(false)

  // Account lifecycle
  deactivatedAt       TimestamptzString?
  deletionRequestedAt TimestamptzString?
  scheduledDeletionAt TimestamptzString?
  deletedAt           TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  // Authentication
  sessions Session[]

  // Projects
  ownedProjects   Project[]       @relation("ProjectOwner")
  deletedProjects Project[]       @relation("ProjectDeletedBy")
  memberships     ProjectMember[]

  // Tasks
  createdTasks  Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")
  deletedTasks  Task[] @relation("TaskDeletedBy")

  // Task assignment history
  assignedTaskHistory TaskAssignmentHistory[] @relation("AssignmentActor")
  previousAssignments TaskAssignmentHistory[] @relation("PreviousAssignee")
  newAssignments      TaskAssignmentHistory[] @relation("NewAssignee")

  // Activity history
  taskActivities     TaskActivity[]     @relation("TaskActivityActor")
  projectActivities  ProjectActivity[]  @relation("ProjectActivityActor")
  accountActivities  AccountActivity[]  @relation("AccountActivityActor")
  accountHistory     AccountActivity[]  @relation("AccountActivityUser")

  // Comments
  comments TaskComment[]

  // Notifications
  notifications Notification[]

  // Invitations
  sentInvitations     ProjectInvitation[] @relation("InvitationSender")
  receivedInvitations ProjectInvitation[] @relation("InvitationRecipient")

  // Membership history
  membershipHistory ProjectMembershipHistory[] @relation("MembershipHistoryUser")
  membershipActions ProjectMembershipHistory[] @relation("MembershipHistoryActor")
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime

  createdAt TimestamptzString @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  status      String
  startDate   DateTime
  dueDate     DateTime

  // Ownership
  ownerId Int
  owner   User @relation(
    "ProjectOwner",
    fields: [ownerId],
    references: [id],
    onDelete: Restrict
  )

  // Membership
  members ProjectMember[]

  // Tasks
  tasks Task[]

  // Lifecycle
  deletedAt           TimestamptzString?
  deletedById         Int?
  scheduledDeletionAt TimestamptzString?

  deletedBy User? @relation(
    "ProjectDeletedBy",
    fields: [deletedById],
    references: [id],
    onDelete: SetNull
  )

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  // History and invitations
  membershipHistory ProjectMembershipHistory[]
  activities        ProjectActivity[]
  invitations       ProjectInvitation[]

  @@index([ownerId])
  @@index([deletedAt])
  @@index([scheduledDeletionAt])
  @@index([deletedById])
}

model ProjectMember {
  id Int @id @default(autoincrement())

  projectId Int
  userId    Int

  project Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Restrict
  )

  addedById Int?
  joinedAt  TimestamptzString @default(now())
  removedAt TimestamptzString?

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

enum ProjectMembershipAction {
  JOINED
  REMOVED
  REJOINED
}

model ProjectMembershipHistory {
  id Int @id @default(autoincrement())

  projectId Int
  userId    Int

  action ProjectMembershipAction

  // User who performed the action
  performedById Int?

  // When the event occurred
  createdAt TimestamptzString @default(now())

  project Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  user User @relation(
    "MembershipHistoryUser",
    fields: [userId],
    references: [id],
    onDelete: Restrict
  )

  performedBy User? @relation(
    "MembershipHistoryActor",
    fields: [performedById],
    references: [id],
    onDelete: SetNull
  )

  @@index(
    [projectId, userId, createdAt],
    map: "pmh_project_user_created_idx"
  )
  @@index([userId, createdAt])
  @@index([performedById])
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      Int
  priority    Int
  dueDate     DateTime?
  projectId   Int

  project Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  // Task creator
  creatorId Int
  creator   User @relation(
    "TaskCreator",
    fields: [creatorId],
    references: [id],
    onDelete: Restrict
  )

  // Current assignee
  assigneeId Int?
  assignee   User? @relation(
    "TaskAssignee",
    fields: [assigneeId],
    references: [id],
    onDelete: SetNull
  )

  // Task deletion lifecycle
  deletedAt           TimestamptzString?
  deletedById         Int?
  scheduledDeletionAt TimestamptzString?

  deletedBy User? @relation(
    "TaskDeletedBy",
    fields: [deletedById],
    references: [id],
    onDelete: SetNull
  )

  // Task history
  assignmentHistory TaskAssignmentHistory[]
  activities        TaskActivity[]
  comments          TaskComment[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([projectId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([deletedAt])
  @@index([scheduledDeletionAt])
  @@index([deletedById])
}

enum TaskAssignmentAction {
  ASSIGNED
  REASSIGNED
  UNASSIGNED
}

model TaskAssignmentHistory {
  id Int @id @default(autoincrement())

  taskId Int
  task   Task @relation(
    fields: [taskId],
    references: [id],
    onDelete: Cascade
  )

  previousAssigneeId Int?
  previousAssignee   User? @relation(
    "PreviousAssignee",
    fields: [previousAssigneeId],
    references: [id],
    onDelete: SetNull
  )

  newAssigneeId Int?
  newAssignee   User? @relation(
    "NewAssignee",
    fields: [newAssigneeId],
    references: [id],
    onDelete: SetNull
  )

  performedById Int?
  performedBy   User? @relation(
    "AssignmentActor",
    fields: [performedById],
    references: [id],
    onDelete: SetNull
  )

  action TaskAssignmentAction

  reason String?

  createdAt TimestamptzString @default(now())

  @@index([taskId, createdAt])
  @@index([previousAssigneeId])
  @@index([newAssigneeId])
  @@index([performedById])
}

enum TaskActivityAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  DELETED
  RESTORED
  CLOSED
  REOPENED
}

model TaskActivity {
  id Int @id @default(autoincrement())

  taskId Int
  task   Task @relation(
    fields: [taskId],
    references: [id],
    onDelete: Cascade
  )

  actorId Int?
  actor   User? @relation(
    "TaskActivityActor",
    fields: [actorId],
    references: [id],
    onDelete: SetNull
  )

  action TaskActivityAction

  // Previous and new values for the changed field
  field    String?
  oldValue String?
  newValue String?

  // Optional additional context
  description String?

  createdAt TimestamptzString @default(now())

  @@index([taskId, createdAt])
  @@index([actorId])
  @@index([action])
}

enum ProjectActivityAction {
  CREATED
  UPDATED
  OWNER_CHANGED
  DELETED
  RESTORED
}

model ProjectActivity {
  id Int @id @default(autoincrement())

  projectId Int
  project   Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  actorId Int?
  actor   User? @relation(
    "ProjectActivityActor",
    fields: [actorId],
    references: [id],
    onDelete: SetNull
  )

  action ProjectActivityAction

  field    String?
  oldValue String?
  newValue String?

  description String?

  createdAt TimestamptzString @default(now())

  @@index([projectId, createdAt])
  @@index([actorId])
  @@index([action])
}

enum AccountActivityAction {
  CREATED
  DEACTIVATED
  REACTIVATED
  DELETION_REQUESTED
  DELETION_CANCELLED
  DELETED
  ROLE_CHANGED
}

model AccountActivity {
  id Int @id @default(autoincrement())

  // Account affected by the action
  userId Int
  user   User @relation(
    "AccountActivityUser",
    fields: [userId],
    references: [id],
    onDelete: Restrict
  )

  // User or administrator who performed the action
  actorId Int?
  actor   User? @relation(
    "AccountActivityActor",
    fields: [actorId],
    references: [id],
    onDelete: SetNull
  )

  action AccountActivityAction

  oldValue String?
  newValue String?

  description String?

  createdAt TimestamptzString @default(now())

  @@index([userId, createdAt])
  @@index([actorId])
  @@index([action])
}

model TaskComment {
  id Int @id @default(autoincrement())

  taskId Int
  task   Task @relation(
    fields: [taskId],
    references: [id],
    onDelete: Cascade
  )

  authorId Int?
  author   User? @relation(
    fields: [authorId],
    references: [id],
    onDelete: SetNull
  )

  content String

  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  deletedAt TimestamptzString?

  @@index([taskId, createdAt])
  @@index([authorId])
  @@index([deletedAt])
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_REASSIGNED
  TASK_UNASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMMENTED
  PROJECT_INVITATION
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED
  PROJECT_OWNERSHIP_TRANSFERRED
  ACCOUNT_DEACTIVATED
  ACCOUNT_DELETION
}

model Notification {
  id Int @id @default(autoincrement())

  // User receiving the notification
  userId Int
  user   User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  type NotificationType

  title   String
  message String

  // Optional references to related resources
  taskId    Int?
  projectId Int?

  // Notification state
  isRead Boolean @default(false)
  readAt TimestamptzString?

  createdAt TimestamptzString @default(now())

  @@index([userId, isRead, createdAt])
  @@index([taskId])
  @@index([projectId])
  @@index([createdAt])
}

enum ProjectInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model ProjectInvitation {
  id Int @id @default(autoincrement())

  projectId Int
  project   Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  senderId Int
  sender   User @relation(
    "InvitationSender",
    fields: [senderId],
    references: [id],
    onDelete: Restrict
  )

  recipientId Int?
  recipient   User? @relation(
    "InvitationRecipient",
    fields: [recipientId],
    references: [id],
    onDelete: SetNull
  )

  // Email address invited, retained even if the user is deleted
  email String

  // Store a hash of the invitation token, never the raw token
  tokenHash String @unique

  status ProjectInvitationStatus @default(PENDING)

  expiresAt TimestamptzString

  acceptedAt TimestamptzString?
  rejectedAt TimestamptzString?
  cancelledAt TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@index([projectId, status])
  @@index([recipientId, status])
  @@index([email, status])
  @@index([expiresAt])
}